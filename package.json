{
  "name": "common-scripts",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Repo maintenance scripts. The scripts have no dependencies; the packages below are only for linting, formatting and type checking.",
  "bin": {
    "devkit": "index.mjs"
  },
  "files": [
    "index.mjs",
    "lib/"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "typecheck": "tsc",
    "test": "node --test",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^18.19.130",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^65.3.2",
    "globals": "^17.13.0",
    "typescript": "^6.0.3"
  }
}
